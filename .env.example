# ─── Client-exposed (NEXT_PUBLIC_*) ────────────────────────────────────────
# Parallelism configuration. These control how cards are processed in batches
# on the client before being sent to /api/check. Keep batch size modest to
# avoid rate-limiting from the upstream API.
NEXT_PUBLIC_BATCH_SIZE=10
NEXT_PUBLIC_BATCH_DELAY_MS=300
NEXT_PUBLIC_MAX_CARDS_TOTAL=1000

# Upstream API timeout (ms). Per-card request timeout.
NEXT_PUBLIC_CHKR_TIMEOUT_MS=15000

# Upstream card checker URL. Default is chkr.cc public endpoint.
NEXT_PUBLIC_CHKR_API_URL=https://api.chkr.cc/

# ─── Server-only ───────────────────────────────────────────────────────────
# Hard cap on batch size accepted by /api/check route (defense in depth).
MAX_CARDS_PER_BATCH=25
